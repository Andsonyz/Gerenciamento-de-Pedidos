# Opcional. Copie para .env na raiz. Nunca inclua senhas neste arquivo.
PORT=3001
# DATABASE_PATH=C:\DadosRestaurante\restaurant.sqlite
# SIMULATION_DATABASE_PATH=C:\DadosRestaurante\simulation.sqlite
# Limite à sub-rede do restaurante, substituindo o exemplo:
# ALLOWED_SUBNETS=192.168.1.0/24
# ALLOWED_ORIGINS=http://192.168.1.20:3001,http://localhost:3001,http://192.168.1.20:5173,http://localhost:5173
# HTTPS local: caminhos absolutos para certificado confiável e chave privada.
# TLS_CERT=C:\Certificados\restaurante.pem
# TLS_KEY=C:\Certificados\restaurante-key.pem
# Integração opcional com dashboard; somente treinamento. Segredos nunca usam VITE_.
# DASHBOARD_SYNC_URL=https://SEU-PROJETO.supabase.co/functions/v1/sync-ingest
# DASHBOARD_RESTAURANT_ID=<UUID gerado no provisionamento>
# DASHBOARD_SOURCE_ID=<UUID gerado no provisionamento>
# DASHBOARD_DEVICE_TOKEN=<token gerado; não incluir em Git>
